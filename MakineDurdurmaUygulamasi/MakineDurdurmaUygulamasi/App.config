    </startup>
	<connectionStrings>
		<add name="ModbusDb"
			 connectionString="Data Source=NEDEN10;Initial Catalog=DB_MODBUS;Integrated Security=True;TrustServerCertificate=True"
			 providerName="System.Data.SqlClient" />
