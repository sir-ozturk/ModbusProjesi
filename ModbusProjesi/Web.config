<configuration>
	<connectionStrings>
		<add name="ModbusDb"
			 connectionString="Data Source=NEDEN10;Initial Catalog=DB_MODBUS;Integrated Security=True;TrustServerCertificate=True"
			 providerName="System.Data.SqlClient"/>
	</connectionStrings>
	<system.web>
		<compilation debug="true" targetFramework="4.8.1" />
		<httpRuntime targetFramework="4.8.1" />
		<sessionState timeout="20"></sessionState>
	</system.web>


	<system.codedom>
		<compilers>

		</compilers>
	</system.codedom>
</configuration>