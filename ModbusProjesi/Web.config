<configuration>
	<appSettings>
		<!-- Mevcut makine_no alanı; kayıt ID'si değildir. Yalnızca röle 1 kontrol edilir. -->
		<add key="RoleBirMakineNo" value="18" />
		<add key="RoleCihazAdresi" value="http://192.168.5.190:8080/" />
		<add key="TurnstileSiteKey" value="0x4AAAAAAEXjdun9as6hpWS6" />
		<add key="TurnstileSecretKey" value="0x4AAAAAAEXjdv0deAcrrLNXaBtX6y36jLk" />
	</appSettings>
	<connectionStrings>
		<add name="ModbusDb"
			 connectionString="Data Source=NEDEN4\SQLEXPRESS01;Initial Catalog=DB_MODBUS;Integrated Security=True;TrustServerCertificate=True"
			 providerName="System.Data.SqlClient"/>
	</connectionStrings>
	<system.web>
		<compilation debug="true" targetFramework="4.8.1" />
		<httpRuntime targetFramework="4.8.1" />
		<globalization requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" culture="tr-TR" uiCulture="tr-TR" />
		<sessionState timeout="20"></sessionState>
	</system.web>


	<system.codedom>
		<compilers>

		</compilers>
	</system.codedom>
</configuration>
